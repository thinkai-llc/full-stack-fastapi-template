{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/after-file-edit.sh",
        "matcher": "Write|StrReplace"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/post-shell-hint.sh",
        "matcher": "Shell"
      }
    ]
  }
}
